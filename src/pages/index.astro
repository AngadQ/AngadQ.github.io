---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, sections, skills } from '../data/portfolio';

const visibleSections = sections.filter((section) => section.visible);
---

<BaseLayout title={`${profile.name} · Academic Portfolio`} description={profile.about}>
  <main id="main-content" class="container">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">Academic portfolio</p>
        <h1 id="intro-title">Hello, I'm <em>Angad.</em></h1>
        <p class="hero-role">{profile.role}</p>
        <p class="hero-location">{profile.location}</p>
        <p class="intro">{profile.about}</p>
        <div class="hero-actions">
          {visibleSections.some((section) => section.slug === 'research') && (
            <a class="button button-primary" href="/research/">Explore my research <span aria-hidden="true">↗</span></a>
          )}
          {profile.email && <a class="text-link" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <div class="portrait-card">
        {profile.portrait ? (
          <img src={profile.portrait} alt={`Portrait of ${profile.name}`} width="520" height="620" />
        ) : (
          <div class="portrait-placeholder" role="img" aria-label="Portrait coming soon"><span>AK</span></div>
        )}
        <p>{profile.portrait ? profile.name : 'Portrait coming soon'}</p>
      </div>
    </section>

    <section class="section-intro" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">A little about me</p>
        <h2 id="about-title">Robotics, learning,<br />and real-world systems.</h2>
      </div>
      <p>My interests include reinforcement learning, embodied intelligence, multi-agent systems, and robot learning. I enjoy connecting ideas from research with experiments on physical systems.</p>
    </section>

    <section class="skills-section" aria-labelledby="skills-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What I work with</p>
          <h2 id="skills-title">Technical skills</h2>
        </div>
      </div>
      <div class="skills-grid">
        {skills.map((skill) => (
          <div class="skill-group">
            <h3>{skill.category}</h3>
            <p>{skill.items}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="browse-section" aria-labelledby="browse-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Take a look around</p>
          <h2 id="browse-title">Explore my work</h2>
        </div>
        <span class="section-count">01 / Portfolio</span>
      </div>
      <div class="section-grid">
        {visibleSections.map((section, index) => (
          <a class="section-card" href={`/${section.slug}/`}>
            <span class="card-number">0{index + 1}</span>
            <span class="card-title">{section.label}</span>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="documents" aria-labelledby="documents-title">
      <div>
        <p class="eyebrow">Documents</p>
        <h2 id="documents-title">Resume & CV</h2>
        <p>Download a concise overview or a more complete academic record.</p>
      </div>
      <div class="document-links">
        {profile.resume ? <a class="button button-light" href={profile.resume} download>Download resume <span aria-hidden="true">↓</span></a> : <span class="document-pending">Resume coming soon</span>}
        {profile.cv ? <a class="button button-light" href={profile.cv} download>Download CV <span aria-hidden="true">↓</span></a> : <span class="document-pending">CV coming soon</span>}
      </div>
    </section>
  </main>
</BaseLayout>
