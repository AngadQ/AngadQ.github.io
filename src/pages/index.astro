---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { news, profile, projects, research, sections } from '../data/portfolio';

const researchVisible = sections.some((section) => section.slug === 'research' && section.visible);
const projectsVisible = sections.some((section) => section.slug === 'projects' && section.visible);
const featuredResearch = research.filter((item) => item.visible && item.featured).slice(0, 2);
const featuredProjects = projects.filter((item) => item.visible && item.featured).slice(0, 2);
---

<BaseLayout title={`${profile.name} · Academic Portfolio`} description={profile.about.join(' ')}>
  <main id="main-content" class="container home-page">
    <section class="about" aria-labelledby="about-title">
      <div class="about-copy">
        <h1 id="about-title">{profile.name}</h1>
        <p class="profile-role">{profile.role}</p>
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}

        <div class="profile-links" aria-label="Contact and profile links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <span>{profile.location}</span>
        </div>
      </div>

      <img
        class="profile-photo"
        src={profile.portrait}
        alt={`Portrait of ${profile.name}`}
        width="170"
        height="240"
      />
    </section>

    <!-- <section class="home-section" aria-labelledby="news-title">
      <div class="home-section-heading">
        <h2 id="news-title">News</h2>
      </div>
      <div class="news-list">
        {news.map((item) => (
          <div class="news-item">
            <time>{item.date}</time>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section> -->

    {researchVisible && featuredResearch.length > 0 && (
      <section class="home-section" aria-labelledby="research-title">
        <div class="home-section-heading">
          <h2 id="research-title">Selected research</h2>
          <a href="/research/">See all research →</a>
        </div>
        <div class="work-list">
          {featuredResearch.map((item) => <WorkCard item={item} kind="research" compact />)}
        </div>
      </section>
    )}

    {projectsVisible && featuredProjects.length > 0 && (
      <section class="home-section" aria-labelledby="projects-title">
        <div class="home-section-heading">
          <h2 id="projects-title">Selected projects</h2>
          <a href="/projects/">See all projects →</a>
        </div>
        <div class="work-list">
          {featuredProjects.map((item) => <WorkCard item={item} kind="projects" compact />)}
        </div>
      </section>
    )}

    <section class="home-section documents-section" aria-labelledby="documents-title">
      <div class="home-section-heading">
        <h2 id="documents-title">Documents</h2>
      </div>
      <p>Download a concise resume or my complete academic CV.</p>
      <div class="document-links">
        <a class="button" href={profile.resume} download>Resume PDF ↓</a>
        <a class="button button-secondary" href={profile.cv} download>Academic CV ↓</a>
      </div>
    </section>
  </main>
</BaseLayout>
