---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  activities,
  education,
  experience,
  projects,
  research,
  sections,
  skills,
} from '../data/portfolio';

export function getStaticPaths() {
  return sections
    .filter((section) => section.visible)
    .map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
const visibleResearch = research.filter((item) => item.visible);
const visibleProjects = projects.filter((item) => item.visible);

const descriptions: Record<string, string> = {
  education: 'My academic background, coursework, and areas of study.',
  experience: 'Professional roles and the practical engineering work that shaped my approach.',
  research: 'Research in robotics, reinforcement learning, autonomy, and multi-agent systems.',
  projects: 'Selected technical and academic projects from my graduate studies.',
  activities: 'Leadership, community, and interests outside the classroom and laboratory.',
};
---

<BaseLayout title={`${section.label} · Angad Kochhar`} description={descriptions[section.slug]}>
  <main id="main-content" class="container listing-page">
    <header class="page-heading">
      <h1>{section.label}</h1>
      <p>{descriptions[section.slug]}</p>
    </header>

    {section.slug === 'education' && (
      <div class="timeline-list">
        {education.map((item) => (
          <article class="timeline-entry">
            <div class="timeline-date">{item.dates}</div>
            <div>
              <h2>{item.degree}</h2>
              <p class="entry-organization">{item.institution}</p>
              <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'experience' && (
      <div class="timeline-list">
        {experience.map((item) => (
          <article class="timeline-entry">
            <div class="timeline-date">{item.dates}</div>
            <div>
              <h2>{item.role}</h2>
              <p class="entry-organization">{item.organization}</p>
              <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'experience' && (
      <section class="skills-block" aria-labelledby="skills-title">
        <h2 id="skills-title">Technical skills</h2>
        <dl>
          {skills.map((skill) => (
            <div>
              <dt>{skill.category}</dt>
              <dd>{skill.items}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {section.slug === 'research' && (
      <div class="work-list page-work-list">
        {visibleResearch.length === 0 && <p class="empty-state">Research details coming soon.</p>}
        {visibleResearch.map((item) => <WorkCard item={item} kind="research" />)}
      </div>
    )}

    {section.slug === 'projects' && (
      <div class="work-list page-work-list">
        {visibleProjects.length === 0 && <p class="empty-state">Projects coming soon.</p>}
        {visibleProjects.map((item) => <WorkCard item={item} kind="projects" />)}
      </div>
    )}

    {section.slug === 'activities' && (
      <div class="timeline-list">
        {activities.map((item) => (
          <article class="timeline-entry">
            <div class="timeline-date">{item.dates}</div>
            <div>
              <h2>{item.title}</h2>
              <p class="entry-organization">{item.organization}</p>
              <p>{item.summary}</p>
              {item.images.map((image) => (
                <figure class="activity-image">
                  <img src={image.src} alt={image.alt} loading="lazy" />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</BaseLayout>
