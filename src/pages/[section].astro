---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  activities,
  education,
  experience,
  projects,
  research,
  sections,
} from '../data/portfolio';

export function getStaticPaths() {
  return sections
    .filter((section) => section.visible)
    .map((section) => ({
      params: { section: section.slug },
      props: { section },
    }));
}

const { section } = Astro.props;
---

<BaseLayout title={`${section.label} · Angad Kochhar`} description={`${section.label} in Angad Kochhar's academic portfolio.`}>
  <main id="main-content" class="container interior-page">
    <a class="back-link" href="/">← Back to home</a>
    <header class="page-heading">
      <p class="eyebrow">Portfolio / {section.label}</p>
      <h1>{section.label}</h1>
      <p>
        {section.slug === 'education' && 'My academic background and coursework.'}
        {section.slug === 'experience' && 'The roles and teams that have shaped my work.'}
        {section.slug === 'research' && 'Questions I have explored and work I have contributed to.'}
        {section.slug === 'projects' && 'Things I have built, tested, and learned from.'}
        {section.slug === 'activities' && 'Communities, interests, and work beyond the classroom.'}
      </p>
    </header>

    {section.slug === 'education' && (
      <div class="entry-list">
        {education.length === 0 && <p class="empty-state">Education details coming soon.</p>}
        {education.map((item) => (
          <article class="entry">
            <div class="entry-meta">{item.dates}</div>
            <div>
              <h2>{item.degree}</h2>
              <p class="entry-organization">{item.institution}</p>
              {item.details.length > 0 && <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'experience' && (
      <div class="entry-list">
        {experience.length === 0 && <p class="empty-state">Work experience details coming soon.</p>}
        {experience.map((item) => (
          <article class="entry">
            <div class="entry-meta">{item.dates}</div>
            <div>
              <h2>{item.role}</h2>
              <p class="entry-organization">{item.organization}</p>
              {item.details.length > 0 && <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'research' && (
      <div class="entry-list">
        {research.length === 0 && <p class="empty-state">Research details coming soon.</p>}
        {research.map((item) => (
          <article class="entry">
            <div class="entry-meta">{item.dates}</div>
            <div>
              <h2>{item.title}</h2>
              <p class="entry-organization">{item.organization}</p>
              <p>{item.summary}</p>
              {item.link && <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer">Read more ↗</a>}
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'projects' && (
      <div class="entry-list">
        {projects.length === 0 && <p class="empty-state">Projects coming soon.</p>}
        {projects.map((item) => (
          <article class="entry project-entry">
            <div class="entry-meta">{item.dates}</div>
            <div>
              <h2>{item.title}</h2>
              <p class="entry-organization">{item.context}</p>
              <p>{item.summary}</p>
              {item.tools.length > 0 && <p class="project-tools">{item.tools.join(' · ')}</p>}
              {item.link && <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer">View project ↗</a>}
              {item.images?.map((image) => <img class="entry-image" src={image.src} alt={image.alt} loading="lazy" />)}
              {item.videoFile && <video class="entry-video" controls preload="metadata" src={item.videoFile}>Your browser does not support video.</video>}
              {item.videoEmbedUrl && <iframe class="entry-video" src={item.videoEmbedUrl} title={`${item.title} video`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>}
            </div>
          </article>
        ))}
      </div>
    )}

    {section.slug === 'activities' && (
      <div class="entry-list">
        {activities.length === 0 && <p class="empty-state">Extracurricular activities coming soon.</p>}
        {activities.map((item) => (
          <article class="entry">
            <div class="entry-meta">{item.dates}</div>
            <div>
              <h2>{item.title}</h2>
              <p class="entry-organization">{item.organization}</p>
              <p>{item.summary}</p>
              {item.images?.map((image) => <img class="entry-image" src={image.src} alt={image.alt} loading="lazy" />)}
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</BaseLayout>
